{
  "name": "kickterino",
  "productName": "Streamterino",
  "version": "0.3.0",
  "description": "Cliente multi-chat da Kick e da Twitch (estilo Chatterino) que mantém você assistindo várias lives para acumular pontos do canal.",
  "author": "VinniiSaantos",
  "license": "MIT",
  "homepage": "https://viinnisantoos.github.io/kickterino/",
  "repository": "github:ViinniSantoos/kickterino",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.streamterino.app",
    "productName": "Streamterino",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ViinniSantoos",
        "repo": "kickterino"
      }
    ],
    "files": [
      "main.js",
      "twitch.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Streamterino-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Streamterino",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Streamterino-portatil.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "kickterino",
      "synopsis": "Chat e pontos da Kick para o PokeIdle",
      "maintainer": "VinniiSaantos <122901997+ViinniSantoos@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Streamterino-linux.AppImage"
    },
    "deb": {
      "artifactName": "Streamterino-linux.deb"
    }
  },
  "desktopName": "kickterino.desktop"
}
